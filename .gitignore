__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store
.fuse_hidden*

# dejavu's own knowledge base. The DB is a rebuildable index; shared knowledge lives in
# .dejavu/*.md, which stays tracked.
.dejavu/knowledge.db
.dejavu/knowledge.db-*
docs/DEVELOPING.md
docs/RELEASING*.md

# dejavu has no runtime dependencies, so this only pins the dev tools (pytest, ruff).
# Not tracked: it would be the only thing forcing a particular resolver version on
# anyone who clones this.
uv.lock
